# =============================================================================
# CAD to USD Converter — Configuration Template
#
# Copy this file to config.env and fill in your values.
# install.bat will create config.env automatically.
# =============================================================================

# Path to kit.exe (required)
# Find yours at: %LOCALAPPDATA%\ov\pkg\kit-<version>\kit.exe
KIT_EXE=C:\Users\YOUR_USERNAME\AppData\Local\ov\pkg\kit-106.1.0\kit.exe

# Default USD output format
# Options: .usd (binary, recommended) | .usda (text/ASCII) | .usdc (explicit binary) | .usdz (zip package)
DEFAULT_OUTPUT_FORMAT=.usd

# Tessellation quality (controls mesh resolution from CAD B-rep surfaces)
#
# FINE   (high quality):  chord=0.001, angle=10   — large output, best curvature fidelity
# MEDIUM (balanced):      chord=0.01,  angle=30   — good default for most engineering models
# COARSE (fast preview):  chord=0.1,   angle=45   — small output, good enough for layout work
#
# Chord error: max distance between the tessellation mesh and the true surface (in model units)
# Angle error: max angular deviation between adjacent triangle normals (degrees)
TESSELLATION_CHORD=0.01
TESSELLATION_ANGLE=30
